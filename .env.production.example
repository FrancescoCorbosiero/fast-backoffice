# Production environment (docs/runbook.md). Copy to .env.production on the
# server, fill every "change-me", and never commit it (it's in .gitignore).

APP_NAME="fast-backoffice"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://backoffice.example.it
APP_TIMEZONE=Europe/Rome
APP_LOCALE=it
APP_FALLBACK_LOCALE=en

DOMAIN=backoffice.example.it   # Caddy: the certificate's name
ACME_EMAIL=you@example.it      # Caddy: Let's Encrypt notices

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=fast_backoffice
DB_USERNAME=fast
DB_PASSWORD=change-me

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_PORT=6379

# Files (PDFs, XML, PEC envelopes): S3-compatible bucket, versioning on.
FILES_DISK=s3
FILES_S3_KEY=change-me
FILES_S3_SECRET=change-me
FILES_S3_REGION=eu-south-1
FILES_S3_BUCKET=fast-backoffice-files
FILES_S3_ENDPOINT=
FILES_S3_USE_PATH_STYLE_ENDPOINT=false

# Database backups (docker/backup): bucket, optional endpoint, retention.
BACKUP_S3_BUCKET=fast-backoffice-backups
BACKUP_S3_PREFIX=database
BACKUP_S3_ENDPOINT=
BACKUP_KEEP_DAYS=30
BACKUP_HOUR=03

# SdI over PEC (docs/sdi.md §2). Addresses and switches are settings in the panel.
PEC_SMTP_HOST=
PEC_SMTP_PORT=465
PEC_SMTP_ENCRYPTION=ssl
PEC_IMAP_HOST=
PEC_IMAP_PORT=993
PEC_IMAP_ENCRYPTION=ssl
PEC_IMAP_FOLDER=INBOX
PEC_USERNAME=
PEC_PASSWORD=

# Mail campaigns through SES; events over SNS to https://$DOMAIN/webhooks/ses.
MAIL_MAILER=ses
MAIL_FROM_ADDRESS=noreply@example.it
MAIL_FROM_NAME="${APP_NAME}"
CAMPAIGN_MAILER=ses
SES_SNS_TOPIC_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1

# Cal.com: webhooks to https://$DOMAIN/webhooks/calcom.
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=
