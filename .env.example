APP_NAME="fast-backoffice"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Rome

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fast_backoffice
DB_USERNAME=fast
DB_PASSWORD=fast

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="backoffice@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Stored files (PDFs, XML, PEC envelopes): an S3-compatible bucket.
# Locally, FILES_DISK=local keeps them under storage/app/private/files.
FILES_DISK=local
FILES_S3_KEY=
FILES_S3_SECRET=
FILES_S3_REGION=eu-south-1
FILES_S3_BUCKET=
FILES_S3_ENDPOINT=
FILES_S3_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# The PEC mailbox for SdI (sdi.md §2). Empty hosts = channel not configured.
PEC_SMTP_HOST=
PEC_SMTP_PORT=465
PEC_SMTP_ENCRYPTION=ssl
PEC_IMAP_HOST=
PEC_IMAP_PORT=993
PEC_IMAP_ENCRYPTION=ssl
PEC_IMAP_FOLDER=INBOX
PEC_USERNAME=
PEC_PASSWORD=

# Cal.com (design.md §4.2, Calendar). Empty = no sync, webhooks refused.
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=

# Mail campaigns (design.md §4.2, Mail): SES through the "ses" mailer, events over SNS.
CAMPAIGN_MAILER=ses
SES_SNS_TOPIC_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1

# Pipeline (design.md §4.2, docs/pipeline.md): client change requests run by the
# Claude Code CLI on a dedicated worker. The key and the git credentials exist
# only in the worker's environment. Previews are served at https://<slug>.<domain>.
ANTHROPIC_API_KEY=
# The model the CLI runs with. Empty = the CLI's default; a Sonnet-class model
# (e.g. claude-sonnet-5-5) is recommended for static-site runs: cheaper and fast enough.
PIPELINE_CLAUDE_MODEL=
PIPELINE_MAX_COST_USD=5
PIPELINE_TIMEOUT_SECONDS=1800
PIPELINE_BUILD_TIMEOUT_SECONDS=900
PIPELINE_PREVIEW_DOMAIN=preview.example.test
PIPELINE_GIT_NAME="fast-backoffice pipeline"
PIPELINE_GIT_EMAIL=pipeline@example.test
# How git reaches the clients' repositories from the worker (a deploy key), e.g.
# "ssh -i /run/secrets/pipeline_deploy_key -o IdentitiesOnly=yes". Empty = the agent socket or none.
PIPELINE_GIT_SSH_COMMAND=
# Sign-in links for the portal: how long they stay valid, and the mailer (empty = MAIL_MAILER,
# "log" outside production so no mail reaches a real client).
PIPELINE_PORTAL_LINK_MINUTES=15
PIPELINE_PORTAL_MAILER=
