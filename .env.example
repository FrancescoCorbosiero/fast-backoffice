APP_NAME="fast-backoffice"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Rome

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fast_backoffice
DB_USERNAME=fast
DB_PASSWORD=fast

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="backoffice@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Stored files (PDFs, XML, PEC envelopes): an S3-compatible bucket.
# Locally, FILES_DISK=local keeps them under storage/app/private/files.
FILES_DISK=local
FILES_S3_KEY=
FILES_S3_SECRET=
FILES_S3_REGION=eu-south-1
FILES_S3_BUCKET=
FILES_S3_ENDPOINT=
FILES_S3_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# The PEC mailbox for SdI (sdi.md §2). Empty hosts = channel not configured.
PEC_SMTP_HOST=
PEC_SMTP_PORT=465
PEC_SMTP_ENCRYPTION=ssl
PEC_IMAP_HOST=
PEC_IMAP_PORT=993
PEC_IMAP_ENCRYPTION=ssl
PEC_IMAP_FOLDER=INBOX
PEC_USERNAME=
PEC_PASSWORD=
